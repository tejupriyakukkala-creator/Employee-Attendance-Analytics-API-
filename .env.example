# MongoDB Connection Configuration (Placeholders only - never commit real credentials)
# Supports both MONGO_URI / MONGO_DB and MONGODB_URI / DATABASE_NAME

MONGO_URI=mongodb+srv://<username>:<password>@<cluster-address>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=attendance_db

# Alternative naming convention:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-address>.mongodb.net/?retryWrites=true&w=majority
# DATABASE_NAME=employee_attendance
